{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/contacts", "destination": "/backend/src/server.js" },
    { "source": "/contacts/(.*)", "destination": "/backend/src/server.js" },
    { "source": "/rag", "destination": "/backend/src/server.js" },
    { "source": "/rag/(.*)", "destination": "/backend/src/server.js" },
    { "source": "/calls", "destination": "/backend/src/server.js" },
    { "source": "/calls/(.*)", "destination": "/backend/src/server.js" },
    { "source": "/webhooks/(.*)", "destination": "/backend/src/server.js" },
    { "source": "/health", "destination": "/backend/src/server.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}