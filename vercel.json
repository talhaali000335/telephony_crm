{
  "installCommand": "npm --prefix backend install && npm --prefix web install",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/contacts", "destination": "/api" },
    { "source": "/rag/(.*)", "destination": "/api" },
    { "source": "/calls/(.*)", "destination": "/api" },
    { "source": "/voice-notes", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/webhooks/(.*)", "destination": "/api" }
  ]
}
